<types xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/types_file.xsd">
    <type id="highway.motorway" numLanes="3" speed="39.44" priority="14" oneway="true" disallow="pedestrian bicycle"/>
    <type id="highway.motorway_link" numLanes="1" speed="22.22" priority="9" oneway="true"
          disallow="pedestrian bicycle"/>
    <type id="highway.trunk" numLanes="2" speed="27.78" priority="13" oneway="false" disallow="pedestrian bicycle"/>
    <type id="highway.trunk_link" numLanes="1" speed="22.22" priority="8" oneway="false" disallow="pedestrian bicycle"/>
    <type id="highway.primary" numLanes="2" speed="27.78" priority="12" oneway="false" disallow="pedestrian bicycle"/>
    <type id="highway.primary_link" numLanes="1" speed="22.22" priority="7" oneway="false"
          disallow="pedestrian bicycle"/>
    <type id="highway.secondary" numLanes="1" speed="27.78" priority="11" oneway="false" disallow="pedestrian bicycle"/>
    <type id="highway.secondary_link" numLanes="1" speed="22.22" priority="6" oneway="false"
          disallow="pedestrian bicycle"/>
    <type id="highway.tertiary" numLanes="1" speed="22.22" priority="10" oneway="false" disallow="pedestrian bicycle"/>
    <type id="highway.tertiary_link" numLanes="1" speed="22.22" priority="5" oneway="false"
          disallow="pedestrian bicycle"/>
    <type id="highway.residential" numLanes="1" speed="13.89" priority="3" oneway="false"
          disallow="pedestrian bicycle"/>
    <type id="highway.unclassified" numLanes="1" speed="13.89" priority="4" oneway="false"
          disallow="pedestrian bicycle"/>
    <type id="highway.service" numLanes="1" speed="5.56" priority="1" oneway="false" allow="delivery passenger"/>

    <!-- Discard non-car types -->
    <type id="highway.pedestrian" discard="true"/>
    <type id="highway.footway" discard="true"/>
    <type id="highway.cycleway" discard="true"/>
    <type id="highway.path" discard="true"/>
    <type id="highway.steps" discard="true"/>
    <type id="railway.rail" discard="true"/>
    <type id="railway.tram" discard="true"/>
    <type id="railway.subway" discard="true"/>
</types>